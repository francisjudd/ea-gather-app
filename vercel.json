{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "openapi": {
      "root": "backend/",
      "entrypoint": "main:app",
      "routes": [
        {
          "src": "/openapi(?:/(.*))?",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ],
          "continue": true
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/openapi/:path*",
      "destination": {
        "service": "openapi"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
