{
  "name": "@ea-gather/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript http://localhost:8000/openapi.json -o ./lib/api/schema.d.ts",
    "api:types:prod": "openapi-typescript https://ea-gather-app.vercel.app/openapi/openapi.json -o ./lib/api/schema.d.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "data:constituencies": "node scripts/export-constituencies.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "mustache": "^4.2.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vercel": "^63.1.2"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "openapi-typescript": "^7.8.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  }
}
